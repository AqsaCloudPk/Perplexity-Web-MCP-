{
  "name": "@aqsacloud/perplexity-web-mcp",
  "version": "1.5.1",
  "description": "MCP server and orchestrator skill for Perplexity (Pro) via Playwright: multi-model comparison, claim verification, caching, and an optional official-API backend. Unofficial.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "perplexity-web-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "configs",
    "scripts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "install-browser": "npx playwright install chromium",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.js",
    "coverage": "node --test --experimental-test-coverage test/*.test.js",
    "eval": "node eval/run-eval.js",
    "login": "node scripts/manual-login.mjs",
    "doctor": "node dist/cli.js doctor"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fastmcp": "^3.34.0",
    "playwright": "^1.58.2",
    "zod": "^4.3.6"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "perplexity",
    "playwright",
    "opencode",
    "claude-code",
    "cursor",
    "research"
  ],
  "license": "MIT",
  "author": "AqsaCloudPk (original perplexity-web-mcp by quequiere)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AqsaCloudPk/Perplexity-Web-MCP-.git"
  },
  "homepage": "https://github.com/AqsaCloudPk/Perplexity-Web-MCP-#readme",
  "bugs": {
    "url": "https://github.com/AqsaCloudPk/Perplexity-Web-MCP-/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
